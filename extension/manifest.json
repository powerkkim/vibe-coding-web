{
  "manifest_version": 3,
  "name": "Vibe Coding 브라우저 도우미",
  "version": "0.1.0",
  "description": "Vibe Coding 챗봇이 이 크롬의 \"Vibe\" 탭 그룹 안에서 페이지를 열고 읽고 클릭·입력하게 해 줍니다.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://powerkkim.github.io/*",
      "http://localhost:5173/*",
      "http://localhost:4186/*"
    ]
  },
  "action": {
    "default_title": "Vibe Coding 브라우저 도우미"
  },
  "icons": {
    "128": "icons/icon-128.png"
  }
}
